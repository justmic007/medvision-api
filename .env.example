# Copy to .env and fill in real values. NEVER commit .env (it's gitignored).

# --- Database (sync driver; MedVision is sync, unlike HealthTrack's async) ---
POSTGRES_DB=medvision
POSTGRES_USER=medvision
POSTGRES_PASSWORD=changeme
# venv-run app uses localhost; the compose 'api' service uses host 'db' instead.
DATABASE_URL=postgresql+psycopg://medvision:changeme@localhost:5432/medvision

# --- JWT (generate a strong secret: `openssl rand -hex 32`) ---
# ROTATE for production; a leaked secret lets anyone forge tokens.
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated allowlist; set to real frontend origin in prod; never "*") ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Email (verification). EMAIL_BACKEND=console for dev, brevo for real sending ---
EMAIL_BACKEND=console
BREVO_API_KEY=change-me-brevo-api-key
EMAIL_SENDER_ADDRESS=you@example.com
EMAIL_SENDER_NAME=MedVision AI
# Base URL the verification link points at (frontend or API), used to build the link.
EMAIL_VERIFICATION_BASE_URL=http://localhost:8000

# --- Object storage (later increment). STORAGE_BACKEND=minio for dev, s3 for R2 ---
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=medvision-files
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key

# --- Environment ---
ENVIRONMENT=development
